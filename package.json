{
  "name": "standalone-webcontainer",
  "version": "0.0.0",
  "private": true,
  "description": "A standalone, browser-native Node.js runtime: in-memory POSIX VFS, service-worker network proxy, and JS-shimmed Node APIs running on the browser's native V8. Built from scratch, MIT-licensed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgkvibez/standalone-webcontainer.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run fixtures:check && npm run corpus:check",
    "fixtures:freeze": "vite-node tools/freeze-fixtures.ts",
    "fixtures:check": "vite-node tools/freeze-fixtures.ts --check",
    "corpus:build": "vite-node tools/build-corpus.ts --write",
    "corpus:check": "vite-node tools/build-corpus.ts --check",
    "dev:browser": "vite",
    "build:browser": "vite build",
    "build:browser:preview": "vite build --mode preview",
    "preview:browser": "vite preview",
    "test:browser": "playwright test",
    "deploy:plan": "vite-node tools/deploy/vercel.ts",
    "deploy:apply": "vite-node tools/deploy/vercel.ts --apply",
    "verify:deployment": "vite-node tools/verify/deployment.ts"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "codemirror": "^6.0.2",
    "semver": "^7.8.6",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "buffer": "^6.0.3",
    "pathe": "^2.0.3"
  }
}
